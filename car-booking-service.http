@carBookingBaseUrl = http://localhost:8080

### List all bookings
# @name listBookings
GET {{carBookingBaseUrl}}/api/v1/bookings?page=0&size=10&sort=bookingId,desc

### Create booking - digital wallet - confirmed
# @name createDigitalWalletBooking
POST {{carBookingBaseUrl}}/api/v1/bookings
Content-Type: application/json

{
  "customerName": "Binu Philip",
  "vehicleId": "VH1001",
  "rentalStartDate": "2026-09-01T10:00:00",
  "rentalEndDate": "2026-09-05T18:00:00",
  "vehicleCategory": "SUV",
  "totalAmount": 500.00,
  "paymentMode": "DIGITAL_WALLET",
  "paymentReference": "WALLET001"
}

### Create booking - cash - confirmed
# @name createCashBooking
POST {{carBookingBaseUrl}}/api/v1/bookings
Content-Type: application/json

{
  "customerName": "John Smith",
  "vehicleId": "VH1002",
  "rentalStartDate": "2026-09-10T10:00:00",
  "rentalEndDate": "2026-09-12T18:00:00",
  "vehicleCategory": "SEDAN",
  "totalAmount": 250.00,
  "paymentMode": "CASH",
  "paymentReference": "CASH001"
}

