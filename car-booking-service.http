###  publish valid bank transfer event
# @name publishValidBankTransferEvent
POST {{carBookingBaseUrl}}/api/v1/payment-events/bank-transfer
Content-Type: application/json

{
  "paymentId": "BANK001",
  "senderAccountNumber": "ACC-1234567890",
  "paymentAmount": 300.00,
  "transactionDetails": "TXN000000001 BKG0000004"
}